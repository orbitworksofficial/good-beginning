# ---- Database (required) ----
# MongoDB connection string, e.g. from MongoDB Atlas → Connect → Drivers
MONGODB_URI=
MONGODB_DB=goodbeginnings

# ---- Admin login (required) ----
# Random secret that signs admin sessions (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# First admin account, used only by `npm run seed:admin`.
# Leave ADMIN_PASSWORD empty to have a random one generated and printed.
ADMIN_EMAIL=gbinfo@gbeginnings.com
ADMIN_PASSWORD=

# ---- Google Analytics (optional: only for the age & gender panel) ----
NEXT_PUBLIC_GA_ID=
GA_PROPERTY_ID=
GA_CLIENT_EMAIL=
# Paste the service account's private_key with its \n line breaks as-is.
GA_PRIVATE_KEY=

# Track visits when running locally (normally only the live site is tracked).
# NEXT_PUBLIC_ANALYTICS_DEBUG=1
